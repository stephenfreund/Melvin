// A loop whose body and exit are both-movers only.  M-while states its
// effect antecedent as an upper bound ((M(A1,P);e1)*;M(A2,P) <= e) with the
// side condition that the ascribed e is not <= L, so the loop is ascribed
// the least larger effect R (a right-mover) and VERIFIES: its iterations
// cannot commit, so looping forever before the commit point is harmless.
// Placed *after* a commit point, the same loop is rejected -- see
// post_commit_loop.mml.
var int x  both-mover if m == tid;
lock m  write right-mover if \old(m) == 0 && m == tid
        write left-mover  if \old(m) == tid && m == 0;

atomic
requires true
ensures  true
spin_local() {
  acquire(m);
  while (x < 10) invariant true { skip; }
  release(m);
}
init x == 0 && m == 0;
